# Node.js dependencies
/node_modules/

# Logs
npm-debug.log
yarn-debug.log
yarn-error.log
*.log

# Runtime data
*.pid
*.seed
*.pid.lock

# Diagnostic reports (Node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Compiled TypeScript files (if you're using TypeScript)
*.js.map
*.d.ts
dist/ # or wherever your compiled output goes

# Build output directories (if you have a build step)
/build/
/dist/
/out/
/coverage/ # for test coverage reports

# Environment variables
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Editor/IDE specific files
.vscode/ # VS Code settings (some people commit this, depends on team preference)
.idea/ # JetBrains IDEs (IntelliJ, WebStorm, etc.)
*.iml # IntelliJ IDEA
.DS_Store # macOS specific files
Thumbs.db # Windows specific files

# Package manager lock files (optional, but often recommended to keep)
# If you want consistent builds across environments, it's generally good to commit:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# If you choose NOT to commit them (less common for most projects, but useful in some cases):
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Output of 'npm pack'
*.tgz

# Other common temporary files
*.tmp
temp/